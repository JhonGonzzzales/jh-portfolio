---
import LinkedInCard from "./LinkedInCard.astro";
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="label reveal"
        >Ánalisis | Diseño | Desarrollo | Ejecución | Mantenimiento</span
      >
      <h1 class="heading-xl reveal reveal-delay-1">
        Hola, te doy la <span class="accent-word">bienvenida!</span>
      </h1>
      <div class="hero-actions reveal reveal-delay-3">
        <a
          href="https://www.linkedin.com/in/jhon-herbert-gonzales-hurtado-1b06a529a/"
          class="btn btn-ghost btn-large btn-linkedin"
          target="_blank"
        >
          <i class="fab fa-linkedin"></i>
          Linkedin
        </a>
        <a
          href="https://drive.google.com/file/d/1WX_KCro3HOxymlEf1lyFAscJ0OfohWN1/view?usp=sharing"
          class="btn btn-ghost btn-large btn-cv"
          target="_blank"
          ><i class="fas fa-file"></i> CV
        </a>
        <a
          href="https://github.com/JhonGonzzzales"
          class="btn btn-ghost btn-large btn-github"
          target="_blank"
        >
          <i class="fab fa-github"></i> GitHub
        </a>
      </div>
    </div>

    <div class="hero-visual reveal reveal-delay-2">
      <LinkedInCard />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-xl) 0;
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .accent-word {
    color: var(--accent);
    position: relative;
    display: inline-block;
  }

  .accent-word::after {
    content: "";
    position: absolute;
    bottom: 0.05em;
    left: 0;
    width: 100%;
    height: 0.15em;
    background: var(--accent);
    opacity: 0.4;
    border-radius: 2px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .hero-actions .btn {
    flex: 1;
    justify-content: center;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    white-space: nowrap;
  }

  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    overflow: hidden;
  }

  .hero-logo img {
    width: 100%;
    filter: drop-shadow(0 20px 40px rgba(51, 51, 51, 0.15));
  }

  /* —— Estilos de marca al hacer Hover —— */
  .btn-linkedin:hover {
    background: #0a66c2;
    border-color: #0a66c2;
    color: #ffffff;
  }

  .btn-github:hover {
    background: #24292e;
    border-color: #24292e;
    color: #ffffff;
  }

  :global([data-theme="dark"]) .btn-github:hover {
    background: #f0f6fc;
    border-color: #f0f6fc;
    color: #0d1117;
  }

  .btn-cv:hover {
    background: #ea4335;
    border-color: #ea4335;
    color: #ffffff;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-lg);
    }

    .hero-content {
      align-items: center;
      order: 1;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      min-height: 300px;
      order: 2;
    }

    .hero-logo {
      max-width: 260px;
    }

    .shape-lima {
      width: 200px;
      height: 200px;
    }

    .shape-violeta {
      width: 120px;
      height: 120px;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
  }
</style>
