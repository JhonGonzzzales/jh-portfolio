<section id="contacto" class="section contact">
  <div class="container">
    <div class="contact-inner reveal">
      <span class="label">Contáctame</span>
      <h2 class="heading-lg">¿Necesitas algo a medida?</h2>
      <p class="body-lg">
        Envíame un mensaje con los detalles de tu proyecto y te responderé a la
        brevedad.
      </p>

      <!-- Formulario de Contacto -->
      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="contact-form"
      >
        <input type="hidden" name="access_key" value="00b7e4dc-10d5-448d-850c-cf97087e8319" />

        <input
          type="hidden"
          name="redirect"
          value="https://jh-portfolio-dwt.pages.dev/gracias"
        />

        <!-- Evitar spam -->
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display: none;"
        />

        <div class="form-group">
          <label for="name" class="form-label">Nombre</label>
          <input
            type="text"
            name="name"
            id="name"
            class="form-input"
            placeholder="Tu nombre"
            required
          />
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Correo electrónico</label>
          <input
            type="email"
            name="email"
            id="email"
            class="form-input"
            placeholder="tu@correo.com"
            required
          />
        </div>

        <div class="form-group">
          <label for="message" class="form-label">Mensaje</label>
          <textarea
            name="message"
            id="message"
            class="form-textarea"
            rows="4"
            placeholder="Cuéntame sobre tu proyecto..."
            required></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-submit">
          <i class="far fa-paper-plane" aria-hidden="true"></i>
          Enviar mensaje
        </button>
      </form>

      <!-- Separador visual -->
      <div class="contact-divider">
        <span>o si prefieres algo más directo</span>
      </div>

      <a
        href="https://wa.me/59161196628?text=Hola%20Herbert,%20quiero%20cotizar%20un%20proyecto"
        class="btn btn-whatsapp btn-large"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-whatsapp" aria-hidden="true"></i>
        WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .contact .label {
    color: var(--accent-secondary);
  }

  .contact .heading-lg {
    color: var(--text);
  }

  .contact .body-lg {
    color: var(--text-muted);
    margin: 0 auto;
  }

  .contact-inner {
    text-align: center;
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
  }

  /* Estilos del Formulario */
  .contact-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-align: left;
    margin-top: var(--space-xs);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .form-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
  }

  .form-input,
  .form-textarea {
    width: 100% !important;
    box-sizing: border-box !important;
    padding: 12px 16px;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(184, 255, 41, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 110px;
  }

  .btn-submit {
    margin-top: var(--space-xs);
    width: 100%;
    justify-content: center;
  }

  .form-input:user-valid,
  .form-textarea:user-valid {
    border-color: #22c55e;
  }

  .form-input:user-invalid,
  .form-textarea:user-invalid {
    border-color: #ef4444;
  }

  .contact-divider {
    width: 100%;
    display: flex;
    align-items: center;
    text-align: center;
    color: var(--text-muted);
    font-size: 1.2rem;
    margin: var(--space-xs) 0;
  }

  .contact-divider::before,
  .contact-divider::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid var(--border);
  }

  .contact-divider span {
    padding: 0 12px;
  }

  .btn-whatsapp {
    width: 100%;
    justify-content: center;
  }
</style>
