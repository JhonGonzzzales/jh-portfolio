<style>
  .tech-marquee-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0.5rem 0;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .marquee-wrapper {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    display: flex;
    user-select: none;
    position: relative;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 8%,
      rgba(0, 0, 0, 1) 92%,
      rgba(0, 0, 0, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 8%,
      rgba(0, 0, 0, 1) 92%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    gap: 8px;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  /* Velocidad de scroll */
  .track-left {
    animation: scroll-left 20s linear infinite;
  }

  .track-right {
    animation: scroll-right 20s linear infinite;
  }

  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  /* Ícono e Imagen */
  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    padding: 2px 4px;
    border-radius: 6px;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .tech-item img {
    width: 1.3rem;
    height: 1.3rem;
    object-fit: contain;
  }

  .tech-item span {
    font-size: 0.55rem;
    font-weight: 600;
    color: var(--text-muted, #777777);
    margin-top: 2px;
    white-space: nowrap;
  }

  .tech-item:hover {
    transform: scale(1.15);
    background-color: rgba(0, 0, 0, 0.05);
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 4px));
    }
  }

  @keyframes scroll-right {
    from {
      transform: translateX(calc(-50% - 4px));
    }
    to {
      transform: translateX(0);
    }
  }

  /* Modo Oscuro */
  :global([data-theme="dark"]) .tech-item span {
    color: #888888;
  }

  :global([data-theme="dark"]) .tech-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }
</style>
